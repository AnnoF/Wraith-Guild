# Base de données PostgreSQL (celle créée sur le VPS)
DATABASE_URL="postgresql://wraithguild_user:motdepasse@localhost:5432/wraithguild"

# NextAuth
NEXTAUTH_URL="https://wraith-guild.fr"
NEXTAUTH_SECRET="generer_avec_openssl_rand_-base64_32"

# Application Discord (portail développeurs Discord)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Bot Discord (permission minimale : lire les membres et rôles du serveur)
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Noms EXACTS des rôles Discord à vérifier (sensibles à la casse). Les
# Guild Master(s) ont aussi le rôle Discord Officier (pas de rôle "Guild
# Leader" séparé à configurer).
DISCORD_ROLE_OFFICIER="Officier"
DISCORD_ROLE_MEMBER="Member"
DISCORD_ROLE_APPLY="Apply"
DISCORD_ROLE_SOCIAL="Social / Casual"

# Secret partagé pour protéger la route POST /api/cron/sync-roles, appelée
# chaque jour par .github/workflows/sync-roles.yml (même valeur que le
# secret GitHub CRON_SECRET du dépôt).
CRON_SECRET=""
