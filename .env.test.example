# Config des tests E2E Playwright — copier en .env.test (jamais commité) et
# remplir avec les vraies valeurs. Voir e2e/README.md pour la procédure
# complète (tunnel SSH vers le Postgres du VPS, création de la base).

# URL de la base wraithguild_test (JAMAIS la base wraithguild de prod !),
# atteinte via un tunnel SSH local : ssh -L 5432:localhost:5432 <user>@51.210.247.13
DATABASE_URL="postgresql://wraithguild_test_user:CHANGE_ME@localhost:5432/wraithguild_test"

# NextAuth — doit rester cohérent entre le serveur de dev lancé par
# Playwright et le script qui signe les cookies de session de test.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="une_valeur_de_test_quelconque_non_partagee_avec_la_prod"

# DiscordProvider exige des valeurs non vides au démarrage de NextAuth, mais
# aucun vrai flux OAuth Discord n'est déclenché pendant les tests E2E (voir
# e2e/helpers/session.ts qui signe directement un cookie de session) : de
# simples valeurs bidon suffisent.
DISCORD_CLIENT_ID="e2e-fake-client-id"
DISCORD_CLIENT_SECRET="e2e-fake-client-secret"

# Volontairement absents en test : DISCORD_BOT_TOKEN / DISCORD_GUILD_ID.
# Toute vérification d'appartenance Discord (fetchGuildMember) échoue alors
# proprement (catch + log) plutôt que d'appeler l'API Discord réelle — voir
# e2e/tests/candidature.spec.ts pour la portée que ça implique côté test.
