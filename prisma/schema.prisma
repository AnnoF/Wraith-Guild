// Schéma de base de données - Site de guilde Camelote
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Hiérarchie (voir src/lib/roleSync.ts pour la résolution depuis Discord,
// et src/lib/auth.ts pour les helpers de droits) :
//   ADMINISTRATEUR — site uniquement, jamais dérivé de Discord ni du job
//                    quotidien de resynchronisation
//   OFFICIER       — rôle Discord DISCORD_ROLE_OFFICIER ou
//                    DISCORD_ROLE_GUILD_LEADER
//   MEMBER         — rôle Discord DISCORD_ROLE_MEMBER (remplace l'ancien
//                    RAIDEUR, mêmes droits)
//   SOCIAL         — rôle Discord DISCORD_ROLE_SOCIAL ; peut s'inscrire aux
//                    raids comme un Member, affiché avec un badge "S" en
//                    composition (voir src/components/RankBadge.tsx)
//   APPLY          — jamais depuis Discord : posé manuellement par un
//                    Officier quand une candidature passe au statut APPLY
//                    (voir PATCH /api/applications/[id]) ; mêmes droits
//                    d'inscription que Member/Social, badge "A"
//   CANDIDAT       — par défaut à la première connexion, sans rôle Discord
//                    reconnu ; cantonné à /candidature
enum SiteRole {
  CANDIDAT
  SOCIAL
  APPLY
  MEMBER
  OFFICIER
  ADMINISTRATEUR
}

enum ApplicationStatus {
  EN_ATTENTE
  APPLY     // un Officier teste le candidat en raid avant décision finale
  ACCEPTEE
  REFUSEE
}

enum CommentVisibility {
  INTERNE   // membres + officiers, jamais visible du candidat
  PARTAGE   // officiers + le candidat concerné (lecture + réponse)
}

enum WowClass {
  PRETRE
  MAGE
  DEMONISTE
  DRUIDE
  VOLEUR
  CHASSEUR
  CHAMAN
  GUERRIER
  PALADIN
}

enum RecruitmentPriority {
  HAUT
  MOYEN
  BAS
  FERME
}

enum Profession {
  HERBALISM
  MINING
  SKINNING
  ALCHEMY
  BLACKSMITHING
  ENCHANTING
  ENGINEERING
  LEATHERWORKING
  TAILORING
  CAMPING // conservé en base pour ne pas bloquer `prisma db push` (suppression = perte de données) ; retiré uniquement de src/lib/professions.ts, donc plus proposé côté UI
}

enum SignupStatus {
  INSCRIT
  RESERVE   // bench
  ABSENT
  DESISTE   // s'est retiré
}

enum RaidStatus {
  OUVERT      // inscriptions ouvertes
  FERME       // inscriptions fermées, en attente
  TERMINE     // raid passé, historique figé
  ANNULE
}

model User {
  id            String   @id @default(cuid())
  discordId     String   @unique
  discordTag    String   // pseudo Discord au moment de la connexion (cache d'affichage)
  displayName   String?  // surnom personnalisé sur le site ; prioritaire sur discordTag si défini
  avatarUrl     String?
  siteRole      SiteRole @default(CANDIDAT)
  isArchived    Boolean  @default(false) // personne partie de la guilde ; masquée de /membres, historique conservé
  vacationStart DateTime? // mode vacances : inscrit auto en ABSENT sur les raids dans cette période
  vacationEnd   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  characters    Character[]
  raidsCreated  Raid[]        @relation("RaidCreatedBy")
  raidSignups   RaidSignup[]
  roleGrantsGiven  RoleAudit[] @relation("GrantedBy")
  roleGrantsReceived RoleAudit[] @relation("GrantedTo")
  applications  Application[]
  applicationComments ApplicationComment[]
}

model Character {
  id            String   @id @default(cuid())
  name          String   // nom primaire
  secondaryName String?  // nom secondaire
  class         WowClass
  spec          String   // dépend de la classe, voir src/lib/classes.ts
  isActive      Boolean  @default(true)
  canRaidLead   Boolean  @default(false) // le joueur se déclare capable de RL ce personnage
  createdAt     DateTime @default(now())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  placements    RaidPlacement[]
  professions   CharacterProfession[]
  bossRoleAssignments BossRoleAssignment[]

  @@unique([userId, name])
}

// Max 2 métiers par personnage, appliqué côté application (voir POST /api/characters)
model CharacterProfession {
  id            String     @id @default(cuid())
  profession    Profession
  isMaxed       Boolean    @default(false)

  characterId   String
  character     Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, profession])
}

// Une soirée de raid : un nom, un créneau (début/fin), et un déroulement
// en une ou plusieurs phases successives (voir RaidPhase). L'inscription
// (RaidSignup) reste globale à toute la soirée — c'est un Officier qui
// place ensuite chaque inscrit dans une phase/instance précise.
model Raid {
  id             String     @id @default(cuid())
  name           String
  date           DateTime   // début de soirée
  endTime        DateTime   // fin de soirée
  status         RaidStatus @default(OUVERT)
  notes          String?
  signupDeadline DateTime?  // au-delà, les inscriptions sont closes même si status reste OUVERT
  createdAt      DateTime   @default(now())

  createdById   String
  createdBy     User       @relation("RaidCreatedBy", fields: [createdById], references: [id])

  phases        RaidPhase[]
  signups       RaidSignup[]
}

// Un bloc du déroulement de la soirée (ex: "phase 1", "phase 2"), ordonné
// par `order`. Les phases sont séquentielles ; les runs d'une même phase
// se déroulent en parallèle (voir RaidRun).
model RaidPhase {
  id      String  @id @default(cuid())
  order   Int

  raidId  String
  raid    Raid    @relation(fields: [raidId], references: [id], onDelete: Cascade)

  runs    RaidRun[]

  @@unique([raidId, order])
}

// Une instance concrète programmée dans une phase (ex: "Onyxia's Lair").
// Plusieurs runs dans la même phase tournent en même temps et doivent
// partager la même taille (voir instancesShareSize) — un joueur ne peut
// être placé (RaidPlacement) que dans une seule run par phase.
model RaidRun {
  id        String   @id @default(cuid())
  title     String   // clé de RAID_INSTANCE_SIZES
  size      Int      // dénormalisé depuis RAID_INSTANCE_SIZES à la création
  order     Int      // position d'affichage au sein de la phase

  phaseId   String
  phase     RaidPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  placements          RaidPlacement[]
  bossRoleAssignments BossRoleAssignment[]

  @@unique([phaseId, order])
}

// Un joueur s'inscrit lui-même (disponibilité pour la soirée entière) ;
// le personnage n'est assigné qu'ensuite par un Officier, phase par
// phase, lors de la construction de la composition (voir
// /officier/raids/[id]/composition) — voir RaidPlacement.
model RaidSignup {
  id            String       @id @default(cuid())
  status        SignupStatus @default(INSCRIT)
  comment       String?      // ex: "dispo après 21h"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  raidId        String
  raid          Raid         @relation(fields: [raidId], references: [id], onDelete: Cascade)

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  placements    RaidPlacement[]

  @@unique([raidId, userId])
}

// Le placement d'un personnage précis dans une instance précise, à un
// slot de sa grille de composition. Au plus un placement par (signup,
// phase) — vérifié côté application, voir PATCH /api/raids/[id]/signup.
model RaidPlacement {
  id            String     @id @default(cuid())
  slot          Int        // position dans la grille de la run (0 à size-1)

  runId         String
  run           RaidRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  signupId      String
  signup        RaidSignup @relation(fields: [signupId], references: [id], onDelete: Cascade)

  characterId   String
  character     Character  @relation(fields: [characterId], references: [id])

  @@unique([runId, slot])
  @@unique([signupId, runId])
}

// "Mode avancé" de la composition : assignation d'un personnage déjà
// placé dans une run (voir RaidPlacement) à un rôle spécifique à un boss
// (ex: Off Tank 2 sur Garr). Rôles définis dans lib/bossRoles.ts, par
// titre de raid.
model BossRoleAssignment {
  id            String     @id @default(cuid())
  boss          String
  role          String

  runId         String
  run           RaidRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([runId, boss, role])
}

// Candidature de recrutement, déposée depuis /candidature par un compte
// CANDIDAT (ou tout autre rôle, mais dans les faits surtout des CANDIDAT).
// Un compte peut avoir plusieurs candidatures dans le temps (historique) :
// une seule "active" à la fois (EN_ATTENTE/APPLY/ACCEPTEE, ou REFUSEE
// depuis moins de REAPPLY_COOLDOWN_DAYS), imposé côté application dans
// POST /api/applications, pas par une contrainte unique en base. Le
// passage à APPLY bascule aussi le siteRole du candidat en APPLY (voir
// PATCH /api/applications/[id]).
model Application {
  id              String            @id @default(cuid())
  status          ApplicationStatus @default(EN_ATTENTE)
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?         // date du passage à ACCEPTEE/REFUSEE, sert au délai avant de repostuler

  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  discordTag      String
  characterName   String
  wowClass        WowClass
  spec            String
  race            String
  level           String
  professions     Profession[]
  addons          String
  uiScreenshotUrl String
  experience      String
  goals           String
  pvpGoals        String
  nightsPerWeek   Int
  availableNights String[]
  discoverySource String
  knownMembers    String
  extra           String?

  comments        ApplicationComment[]
}

// Commentaires sur une candidature : INTERNE (membres/officiers, caché du
// candidat) ou PARTAGE (visible et répondu par le candidat concerné, voir
// permissions dans POST /api/applications/[id]/comments).
model ApplicationComment {
  id            String            @id @default(cuid())
  visibility    CommentVisibility
  body          String
  createdAt     DateTime          @default(now())

  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authorId      String
  author        User              @relation(fields: [authorId], references: [id])
}

// Guide de raid (un boss = une entrée), éditable par les Officiers,
// consultable par tout membre connecté (voir /guide).
model GuideEntry {
  id        String   @id @default(cuid())
  raidTitle String   // une des valeurs de RAID_INSTANCES (lib/raidInstances.ts)
  bossName  String
  videoUrl  String?
  notes     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Souvenir marquant de la guilde (Hall of Fame) : premier down, obtention
// d'un équipement légendaire, remerciement à un membre... Ajouté par les
// Officiers, consultable par tout membre connecté (voir /hall-of-fame).
model HallOfFameEntry {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?   // fichier uploadé, voir src/lib/uploads.ts
  videoUrl    String?   // lien externe (YouTube, clip Twitch...)
  eventDate   DateTime? // date du moment marquant, distincte de createdAt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Progression de guilde affichée sur la page vitrine (accueil / dashboard,
// voir GuildShowcase), éditable par les Administrateurs uniquement (voir
// /api/guild-progress).
model GuildProgressEntry {
  id        String   @id @default(cuid())
  instance  String
  killed    Int
  total     Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// État du recrutement par spécialisation, affiché sur la page vitrine (voir
// GuildShowcase), éditable par les Officiers et Administrateurs (voir
// /api/recruitment). Une ligne par (classe, spé) — spé en String, comme
// Character.spec, voir src/lib/classes.ts (CLASS_SPECS) — créée à l'amorçage
// (voir src/lib/recruitment.ts).
model RecruitmentStatus {
  wowClass  WowClass
  spec      String
  priority  RecruitmentPriority
  updatedAt DateTime            @updatedAt

  @@id([wowClass, spec])
}

// Historique des changements de rôle site (traçabilité pour les admins).
// grantedById est nullable : le job quotidien de resynchronisation Discord
// (POST /api/cron/sync-roles) journalise aussi ses changements, sans
// auteur humain.
model RoleAudit {
  id            String   @id @default(cuid())
  previousRole  SiteRole
  newRole       SiteRole
  createdAt     DateTime @default(now())

  targetUserId  String
  targetUser    User     @relation("GrantedTo", fields: [targetUserId], references: [id], onDelete: Cascade)

  grantedById   String?
  grantedBy     User?    @relation("GrantedBy", fields: [grantedById], references: [id])
}
